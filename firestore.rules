rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // GLOBAL HELPERS
    // ---------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isUser(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "cryptojacxas@gmail.com"
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ---------------------------------------------------------
    // ENTITY VALIDATORS
    // ---------------------------------------------------------

    function isValidUser(data) {
      return data.get('email', '') is string && 
             data.get('email', '').size() <= 128 &&
             data.get('earnings', 0) is number &&
             (data.get('status', 'active') in ['active', 'flagged', 'banned']) &&
             (data.get('role', 'user') in ['user', 'admin', 'root']) &&
             (data.get('displayName', '') == null || data.get('displayName', '') is string) &&
             (data.get('preferences', {}) is map);
    }

    function isValidVPNNode(data) {
      return data.keys().hasAll(['name', 'country', 'status', 'type']) &&
             data.name is string && data.name.size() <= 100 &&
             data.country is string && data.country.size() <= 100 &&
             data.status in ['online', 'busy', 'offline'] &&
             data.type in ['free', 'premium'];
    }

    // ---------------------------------------------------------
    // ROUTES
    // ---------------------------------------------------------

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin(); // Only existing admins or the master admin can add/remove admins
    }

    match /users/{uid} {
      allow get: if isUser(uid) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isUser(uid) && isValidUser(incoming()) && 
                      incoming().earnings == 0 &&
                      incoming().email == request.auth.token.email &&
                      incoming().get('role', 'user') == 'user' &&
                      incoming().get('status', 'active') == 'active';
      
      allow update: if (isUser(uid) || isAdmin()) && isValidUser(incoming()) && (
        // Action: User self-update (protected fields)
        (isUser(uid) && 
         !incoming().diff(existing()).affectedKeys().hasAny(['status', 'role', 'email']) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['preferences', 'lastActive', 'earnings', 'displayName'])) ||
        // Action: Admin override
        isAdmin()
      );
    }

    match /vpn_nodes/{nodeId} {
      allow read: if isValidId(nodeId);
      allow write: if isAdmin() && isValidVPNNode(incoming()) && isValidId(nodeId);
    }

    match /logs/{logId} {
      allow create: if isSignedIn() && isValidId(logId);
      allow read: if isAdmin();
    }
  }
}
